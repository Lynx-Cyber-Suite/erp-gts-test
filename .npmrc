# Tous les paquets passent par le proxy de confiance npm de Lynx Chain Guard (aucun accès direct à registry.npmjs.org).
# Le jeton vient de la variable d'environnement LYNX_REGISTRY_TOKEN (secret de CI / secret de build), jamais écrit ici.
registry=https://api-chainguard-stg.lynx-cyber.com/npm/npm-gts-proxy/
//api-chainguard-stg.lynx-cyber.com/npm/npm-gts-proxy/:_authToken=${LYNX_REGISTRY_TOKEN}
audit=false
fund=false
